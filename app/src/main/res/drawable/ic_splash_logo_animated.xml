<?xml version="1.0" encoding="utf-8"?>
<!--
    Animated splash icon: wraps the real logo PNG in a rotate animation.
    Android SplashScreen API requires an AnimatedVectorDrawable for animated icons,
    so we use a thin AVD wrapper that rotates a group containing the bitmap.
-->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_splash_logo">

    <target
        android:name="logoGroup"
        android:animation="@animator/splash_rotate" />

</animated-vector>
